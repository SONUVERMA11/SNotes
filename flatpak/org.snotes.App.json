{
    "id": "org.snotes.App",
    "runtime": "org.gnome.Platform",
    "runtime-version": "46",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "snotes-gtk",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--device=all",
        "--filesystem=home:ro",
        "--filesystem=xdg-documents",
        "--talk-name=org.freedesktop.Flatpak",
        "--system-talk-name=org.freedesktop.login1"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/snotes/cargo",
            "RUST_BACKTRACE": "1"
        }
    },
    "modules": [
        {
            "name": "snotes",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release -p snotes-gtk -p snotes-cli -p snotes-sync",
                "install -Dm755 target/release/snotes-gtk /app/bin/snotes-gtk",
                "install -Dm755 target/release/snotes-cli /app/bin/snotes-cli",
                "install -Dm755 target/release/snotes-sync /app/bin/snotes-sync",
                "install -Dm644 data/org.snotes.App.desktop /app/share/applications/org.snotes.App.desktop",
                "install -Dm644 data/org.snotes.App.metainfo.xml /app/share/metainfo/org.snotes.App.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
